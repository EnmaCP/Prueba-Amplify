# Puerto del servidor
PORT=3000

# Nombre de la tabla en DynamoDB
TABLE_NAME=FestivalEvents

# Región de AWS (ej: us-east-1 si usas AWS Academy / Learner Lab, o eu-west-1)
AWS_REGION=us-east-1

# Credenciales de AWS
# Si estás en AWS Academy / Learner Lab, copia los valores del botón "AWS Details"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Opcional: si usas DynamoDB Local en Docker, descomenta la siguiente línea:
# DYNAMODB_ENDPOINT=http://localhost:8000

